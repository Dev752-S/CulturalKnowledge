# SKP Cultural Fest 2026 - Skill Arena Environment Configuration
NODE_ENV=development
PORT=3001

# Authoritative Database (PostgreSQL / Neon Serverless)
# Format: postgresql://[user]:[password]@[neon-hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skp_skill_arena

# Realtime / Rate Limiting (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=https://mock-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=mock_token_for_dev

# Session and CSRF Security
SESSION_SECRET=skp_skill_arena_development_secret_key_at_least_32_chars_long
CSRF_SECRET=skp_skill_arena_csrf_secret_key_at_least_32_chars_long

# Object Storage (Supabase / S3-compatible)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=skill-arena-assets

# Optional CORS Origin (for dev / preview domains)
CORS_ORIGIN=http://localhost:3000
